<?xml version="1.0" encoding="utf-8"?>
<!-- 尺寸常量与 data/WidgetLayout.kt 保持一致：头部 18dp / 普通行 30dp / 宽松行 36dp / 底部 12dp / 上下内边距 8dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 「10:00 下课 / 10:20 上课」：绝对时间，不依赖秒级倒计时基准 -->
        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 课程行：Provider 里按尺寸 removeAllViews + addView，行布局见 widget_today_row*.xml -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:gravity="center_vertical"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
