<?xml version="1.0" encoding="utf-8"?>
<!-- 尺寸常量与 data/WidgetLayout.kt 保持一致：头部 16dp / 上下内边距 4dp；行高由 row 布局决定。
     没有底部提示行：当天所有课程都必须显示，不再出现「早先 N 门已上完」这类文字。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="10dp"
    android:paddingVertical="2dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 只在空状态显示一句提示（今天没有课 / 点此导入课表）；有课时隐藏，
             不再显示「10:00 下课 / 10:20 上课」这类上课时间提示 -->
        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 课程行：Provider 里按尺寸 removeAllViews + addView，行布局见 widget_today_row*.xml -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
